        dc = 15;
        reason = "Conocimiento arcano o antiguo";
      }

      return { skill: skill, stat: stat, dc: dc, reason: reason };
    }
  },
  {
    name: 'healing',
    keywords: ['curar', 'sanar', 'medicina', 'tratamiento', 'cuidar', 'aliviar', 'herida'],
    determine: (actionLower) => {
      let skill = 'Medicina';
